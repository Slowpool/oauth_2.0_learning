<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="4" author="slowpool">
        <createTable tableName="clients">
            <column name="id" type="int">
                <constraints primaryKey="true" />
            </column>
            <column name="client_id" type="varchar(100)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="password_hash" type="char(128)">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="5" author="slowpool">
        <addColumn tableName="access_tokens">
            <column name="client_id" type="int">
                <constraints nullable="false" foreignKeyName="access_token_client_id" references="clients(id)" />
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>