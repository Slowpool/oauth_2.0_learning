{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "AuthorizationServerApplication",
            "request": "attach",
            "hostName": "localhost",
            "port": "5015",
            "projectName": "authorization_server",
            "preLaunchTask": "WaitForBootstrap"
        },
        {
            "type": "java",
            "name": "ClientApplication",
            "request": "attach",
            "hostName": "localhost",
            "port": "5016",
            "projectName": "client",
            "preLaunchTask": "WaitForBootstrap"
        },
        {
            "type": "java",
            "name": "ProtectedResourceApplication",
            "request": "attach",
            "hostName": "localhost",
            "port": "5017",
            "projectName": "protected_resource",
            "preLaunchTask": "WaitForBootstrap"
        }
    ],
    "compounds": [
        {
            "name": "debug",
            "configurations": [
                "Current File",
                "AuthorizationServerApplication",
                "ClientApplication",
                "ProtectedResourceApplication"
            ]
        }
    ]
}